  "info": {
    "_postman_id": "ff3ce6f0-17f1-400c-9b5c-80853d1e089c",
    "name": "Ansible Galaxy Roles & Ansible Galaxy Roles & API Collections API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Ansible Galaxy public REST API for discovering and consuming community\nAnsible content. The legacy v1 surface covers community roles (search by\nkeyword, author, tag; download by version), users, namespaces, and import\ntracking. The modern v3 surface is the Galaxy NG / Pulp API used by\nAnsible collections (the modern packaging format that bundles roles,\nmodules, plugins, and playbooks).\n\n\nContact Support:\n Name: Ansible Galaxy",
      "type": "text/plain"
    }
  }
